# Unyoke on a VPS that already runs other sites with Caddy.
# setup.sh copies this to /etc/caddy/unyoke.caddy and imports it from the main Caddyfile.
unyoke.duckdns.org {
	encode zstd gzip
	root * /opt/unyoke/dist

	# The QoreChain testnet REST API sends no CORS headers, so the app reaches it
	# through this same origin. Read-only GET requests only; nothing is signed here.
	handle_path /lcd-testnet/* {
		@notget not method GET HEAD OPTIONS
		respond @notget 405
		reverse_proxy https://api-testnet.qore.host {
			header_up Host api-testnet.qore.host
		}
	}

	# Vite puts a content hash in every asset name, so they can be cached for good.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Single-page app: /app and any other route load index.html. Inside its own
	# handle so the rewrite never catches /lcd-testnet requests.
	handle {
		try_files {path} /index.html
		file_server
	}
}
