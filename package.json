{
  "name": "unyoke",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Find and remove every standing permission on a QoreChain account, on both lanes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "node --env-file-if-exists=.env.seed --import tsx scripts/seed-demo.ts",
    "e2e:testnet": "node --env-file-if-exists=.env.seed --import tsx scripts/e2e-testnet.ts",
    "build:contract": "tsx scripts/build-contract.ts",
    "deploy:pqc-check": "node --env-file-if-exists=.env.seed --import tsx scripts/deploy-pqc-check.ts",
    "amm:swap": "node --env-file-if-exists=.env.seed --import tsx scripts/amm-swap.ts",
    "qoreseal:register": "node --env-file-if-exists=.env.seed --import tsx scripts/register-qoreseal-key.ts"
  },
  "dependencies": {
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qorex-rainbowkit": "^0.1.0",
    "@qorechain/qorex-types": "^0.1.0",
    "@qorechain/sdk": "^0.14.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.59.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "~2.53.1",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/qorex-wallet-mock": "^0.1.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "solc": "0.8.28",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
